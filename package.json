{
  "name": "lunar-picker",
  "version": "2.0.0",
  "description": "移动端公历/农历日期选择器，支持 Vue 3、React 18 和 React 19",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "keywords": [
    "date-picker",
    "lunar",
    "calendar",
    "vue",
    "react",
    "mobile",
    "农历"
  ],
  "author": "Gavinoio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gavinoio/lunar-picker.git"
  },
  "bugs": {
    "url": "https://github.com/Gavinoio/lunar-picker/issues"
  },
  "homepage": "https://github.com/Gavinoio/lunar-picker#readme",
  "main": "./dist/core.js",
  "module": "./dist/core.mjs",
  "types": "./dist/core.d.ts",
  "exports": {
    ".": {
      "import": "./dist/core.mjs",
      "require": "./dist/core.js",
      "types": "./dist/core.d.ts"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "browser": {
        "import": "./dist/vue.browser.mjs",
        "require": "./dist/vue.browser.js"
      },
      "import": "./dist/vue.mjs",
      "require": "./dist/vue.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "browser": {
        "import": "./dist/react.browser.mjs",
        "require": "./dist/react.browser.js"
      },
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "dist/*.browser.*",
    "**/*.css",
    "*.vue"
  ],
  "files": [
    "dist",
    "assets/*.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "dev:vue": "npm run dev -w vue-demo --",
    "dev:react": "npm run dev -w react-demo --",
    "build": "vite build && node scripts/create-browser-style-entries.mjs",
    "build:vue-demo": "npm run build -w vue-demo",
    "build:react-demo": "npm run build -w react-demo",
    "preview": "vite preview",
    "lint": "eslint packages --ext .ts,.tsx,.vue",
    "lint:fix": "eslint packages --ext .ts,.tsx,.vue --fix",
    "format": "prettier --write \"packages/**/*.{ts,tsx,vue,css}\"",
    "test": "vitest",
    "test:package": "node scripts/verify-package-exports.mjs",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vue/test-utils": "^2.4.0",
    "autoprefixer": "^10.4.27",
    "cssnano": "^7.1.3",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^29.0.0",
    "postcss": "^8.5.8",
    "prettier": "^3.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "terser": "^5.46.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^4.1.0",
    "vue": "^3.4.0"
  }
}
